{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/cli": {
      "release-type": "node",
      "package-name": "@the-i18n-kit/cli",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "component": "the-i18n-kit-cli",
      "extra-files": [
        {
          "type": "generic",
          "path": "/action.yml"
        },
        {
          "type": "generic",
          "path": "/gitlab-ci.yml"
        }
      ]
    },
    "packages/mcp": {
      "release-type": "node",
      "package-name": "@the-i18n-kit/mcp",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "component": "the-i18n-kit-mcp",
      "extra-files": [
        {
          "type": "json",
          "path": "/server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/server.json",
          "jsonpath": "$.packages[0].version"
        }
      ]
    },
    "packages/nuxt": {
      "release-type": "node",
      "package-name": "@the-i18n-kit/nuxt",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "component": "the-i18n-kit-nuxt"
    },
    "packages/eslint-plugin-vue": {
      "release-type": "node",
      "package-name": "@the-i18n-kit/eslint-plugin-vue",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "component": "the-i18n-kit-eslint-plugin-vue"
    },
    "packages/mcp-compat": {
      "release-type": "node",
      "package-name": "the-i18n-mcp",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "component": "the-i18n-mcp"
    }
  }
}
