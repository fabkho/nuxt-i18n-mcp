{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "test": "pnpm -r --filter='./packages/*' --filter='./integrations/*' test && pnpm --filter @the-i18n-kit/docs test",
    "lint": "eslint packages/*/src/ integrations/*/*.ts docs/generate/ docs/tests/",
    "generate:schema": "node scripts/generate-schema.mjs",
    "typecheck": "pnpm --filter @the-i18n-kit/cli build && pnpm -r --filter='./packages/*' --filter='./integrations/*' typecheck && pnpm --filter @the-i18n-kit/docs typecheck",
    "docs:generate": "pnpm --filter @the-i18n-kit/docs generate:reference"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.41"
    }
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
